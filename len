local function filtrarZonaMuerta(valor)
	if math.abs(valor) < ZONA_MUERTA_MANDO then
		return 0
	end
	return valor
end

local function establecerAnclajeLocal(anclar)
	local char = player.Character
	local rootPart = char and char:FindFirstChild("HumanoidRootPart")
	if rootPart then
		rootPart.Anchored = anclar
	end
end

local function restaurarCamaraYPersonaje()
	espectandoJugador = false
	camaraLibreActiva = false

	if conexionCamaraLibre then
		conexionCamaraLibre:Disconnect()
		conexionCamaraLibre = nil
	end

	UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	establecerAnclajeLocal(false)

	camera = workspace.CurrentCamera
	if camera then
		camera.CameraType = Enum.CameraType.Custom
		local char = player.Character
		local humanoid = char and char:FindFirstChildOfClass("Humanoid")
		if humanoid then
			camera.CameraSubject = humanoid
		end
	end

