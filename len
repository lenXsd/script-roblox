local function leerEstadoMando()
	local stickIzq = Vector2.zero
	local stickDer = Vector2.zero
	local subirMando = 0
	local bajarMando = 0
	local turboMando = false

	local estados = UserInputService:GetGamepadState(Enum.UserInputType.Gamepad1)
	for _, input in ipairs(estados) do
		if input.KeyCode == Enum.KeyCode.Thumbstick1 then
			stickIzq = Vector2.new(filtrarZonaMuerta(input.Position.X), filtrarZonaMuerta(input.Position.Y))
		elseif input.KeyCode == Enum.KeyCode.Thumbstick2 then
			stickDer = Vector2.new(filtrarZonaMuerta(input.Position.X), filtrarZonaMuerta(input.Position.Y))
		elseif input.KeyCode == Enum.KeyCode.ButtonR2 then
			subirMando = math.max(subirMando, filtrarZonaMuerta(input.Position.Z))
		elseif input.KeyCode == Enum.KeyCode.ButtonL2 then
			bajarMando = math.max(bajarMando, filtrarZonaMuerta(input.Position.Z))
		end
	end

	if UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonR1) then
		subirMando = 1
	end
	if UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonL1) then
		bajarMando = 1
	end
	if UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonL3) or
	   UserInputService:IsGamepadButtonDown(Enum.UserInputType.Gamepad1, Enum.KeyCode.ButtonX) then
		turboMando = true
	end

	return stickIzq, stickDer, subirMando, bajarMando, turboMando
end

local function bucleCamaraLibre(deltaTime)
	camera = workspace.CurrentCamera
	if not camera then return end

	local stickIzq, stickDer, subirMando, bajarMando, turboMando = leerEstadoMando()

	-- 1. Rotación con Ratón (Clic Derecho)
	if UserInputService:IsMouseButtonPressed(Enum.UserInputType.MouseButton2) then
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCurrentPosition
		local delta = UserInputService:GetMouseDelta()
		camYaw = camYaw - delta.X * SENSIBILIDAD_RATON
		camPitch = math.clamp(camPitch - delta.Y * SENSIBILIDAD_RATON, -math.rad(89), math.rad(89))
	else
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
	end

	-- 2. Rotación con Mando (Stick Derecho / Thumbstick2)
	if stickDer.Magnitude > 0 then
		camYaw = camYaw - (stickDer.X * SENSIBILIDAD_MANDO * deltaTime)
		camPitch = math.clamp(camPitch + (stickDer.Y * SENSIBILIDAD_MANDO * deltaTime), -math.rad(89), math.rad(89))
	end

	local rotacionCFrame = CFrame.Angles(0, camYaw, 0) * CFrame.Angles(camPitch, 0, 0)
	local direccionMovimiento = Vector3.zero

	-- 3. Movimiento con Teclado
	if not UserInputService:GetFocusedTextBox() then
		if UserInputService:IsKeyDown(Enum.KeyCode.W) then direccionMovimiento += rotacionCFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.S) then direccionMovimiento -= rotacionCFrame.LookVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.D) then direccionMovimiento += rotacionCFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.A) then direccionMovimiento -= rotacionCFrame.RightVector end
		if UserInputService:IsKeyDown(Enum.KeyCode.E) or UserInputService:IsKeyDown(Enum.KeyCode.Space) then
			direccionMovimiento += Vector3.new(0, 1, 0)
		end
		if UserInputService:IsKeyDown(Enum.KeyCode.Q) or UserInputService:IsKeyDown(Enum.KeyCode.LeftControl) then
			direccionMovimiento -= Vector3.new(0, 1, 0)
		end
	end

	-- 4. Movimiento con Mando (Stick Izquierdo y Gatillos/Botones superiores)
	if stickIzq.Magnitude > 0 then
		direccionMovimiento += (rotacionCFrame.LookVector * stickIzq.Y) + (rotacionCFrame.RightVector * stickIzq.X)
	end
	if subirMando > 0 then
		direccionMovimiento += Vector3.new(0, subirMando, 0)
	end
	if bajarMando > 0 then
		direccionMovimiento -= Vector3.new(0, bajarMando, 0)
	end

	-- 5. Aplicación de Velocidad y Turbo (LeftShift o L3/X en Mando)
	local usaTurbo = UserInputService:IsKeyDown(Enum.KeyCode.LeftShift) or turboMando
	local multiplicador = usaTurbo and 2.5 or 1

	if direccionMovimiento.Magnitude > 0 then
		local magnitudLimitada = math.min(direccionMovimiento.Magnitude, 1)
		camPos = camPos + (direccionMovimiento.Unit * magnitudLimitada * VELOCIDAD_CAMARA * multiplicador * deltaTime)
	end

	camera.CFrame = CFrame.new(camPos) * rotacionCFrame
end

local function onSpecFreeClick()
	if camaraLibreActiva then
		restaurarCamaraYPersonaje()
