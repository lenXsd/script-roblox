	specFreeButton.BackgroundColor3 = Color3.fromRGB(200, 50, 50)
end

-- Lógica de Rastreo Híbrido
local isTracking = false
local trackingTarget = nil
local visualFolder = nil

local function limpiarVisuales()
	if visualFolder then
		visualFolder:Destroy()
		visualFolder = nil
	end
end

local function crearParteGuia(posicion)
	local part = Instance.new("Part")
	part.Size = Vector3.new(1, 1, 1)
	part.Position = posicion
	part.Anchored = true
	part.CanCollide = false
	part.Transparency = 1
	part.Parent = visualFolder
	local att = Instance.new("Attachment")
	att.Parent = part
	return part, att
end

local function dibujarCamino(waypoints)
	limpiarVisuales()
	visualFolder = Instance.new("Folder")
	visualFolder.Name = "RastreoVisuals"
	visualFolder.Parent = workspace

	local previousAttachment = nil
	for _, waypoint in pairs(waypoints) do
		local part, attachment = crearParteGuia(waypoint.Position + Vector3.new(0, 2, 0))

		if previousAttachment then
			local beam = Instance.new("Beam")
			beam.Attachment0 = previousAttachment
			beam.Attachment1 = attachment
			beam.Width0 = 0.5
			beam.Width1 = 0.5
			beam.FaceCamera = true

			if waypoint.Action == Enum.PathWaypointAction.Jump then
				beam.Color = ColorSequence.new(Color3.fromRGB(255, 255, 0))
			else
				beam.Color = ColorSequence.new(Color3.fromRGB(0, 255, 127))
			end
			beam.Parent = part
		end
		previousAttachment = attachment
	end
end

local function dibujarLineaDirecta(startPos, endPos)
	limpiarVisuales()
	visualFolder = Instance.new("Folder")
	visualFolder.Name = "RastreoVisuals"
	visualFolder.Parent = workspace

	local partA, attA = crearParteGuia(startPos)
	local _, attB = crearParteGuia(endPos)

	local beam = Instance.new("Beam")
	beam.Attachment0 = attA
	beam.Attachment1 = attB
	beam.Width0 = 0.3
	beam.Width1 = 0.3
	beam.FaceCamera = true
	beam.Color = ColorSequence.new(Color3.fromRGB(255, 0, 0))
	beam.Parent = partA
end

local function loopRastreo()
	task.spawn(function()
		while isTracking and trackingTarget do
			local myChar = player.Character
			local targetChar = trackingTarget.Character

			if myChar and targetChar and myChar:FindFirstChild("HumanoidRootPart") and targetChar:FindFirstChild("HumanoidRootPart") then
				local startPos = myChar.HumanoidRootPart.Position
				local endPos = targetChar.HumanoidRootPart.Position

				local path = PathfindingService:CreatePath({AgentRadius = 2, AgentHeight = 5, AgentCanJump = true})
				local success, _ = pcall(function() path:ComputeAsync(startPos, endPos) end)

				if success and path.Status == Enum.PathStatus.Success then
					dibujarCamino(path:GetWaypoints())
				else
					dibujarLineaDirecta(startPos, endPos)
				end
			end
			task.wait(0.2)
		end
		if not isTracking then limpiarVisuales() end
	end)
end

local function onBotonRastrearClick()
	if isTracking then
		isTracking = false
		trackingTarget = nil
		limpiarVisuales()
		BotonRastrear.Text = "INICIAR RASTREO"
		BotonRastrear.BackgroundColor3 = Color3.fromRGB(0, 120, 255)
	else
		local target = buscarJugador(InputNombre.Text, true)
		if target then
			trackingTarget = target
			InputNombre.Text = target.Name
			isTracking = true
			BotonRastrear.Text = "DETENER RASTREO"
			BotonRastrear.BackgroundColor3 = Color3.fromRGB(255, 170, 0)
			loopRastreo()
		else
			BotonRastrear.Text = "NO ENCONTRADO"
			task.wait(1)
			BotonRastrear.Text = "INICIAR RASTREO"
		end
	end
end

